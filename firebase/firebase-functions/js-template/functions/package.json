{
  "name": "mre-template",
  "version": "0.0.1",
  "description": "MRE Template",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "serve:functions": "npx firebase emulators:start --only functions",
    "serve:common": "npx firebase emulators:start --only functions,firestore,auth,storage",
    "serve:all": "npx firebase emulators:start",
    "shell": "npx firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npx firebase deploy --only functions",
    "logs": "npx firebase functions:log",
    "repro:oncallgenkit-disconnect": "node ./scripts/repro-oncallgenkit-disconnect.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "7.2.5",
    "firebase-tools": "15.18.0",
    "genkit": "^1.35.0"
  }
}
